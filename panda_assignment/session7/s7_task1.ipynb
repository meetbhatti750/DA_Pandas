   "source": [
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "e5ff8ef4",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = {\n",
    "    \"ProductName\": [\"Mobile\", \"Laptop\", \"Headphones\", \"Keyboard\"],\n",
    "    \"Price\": [15000, 50000, 2000, 1000],\n",
    "    \"Qty\": [2, 1, 3, 2]\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "6592507f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  ProductName  Price  Qty  TotalValue\n",
      "0      Mobile  15000    2       30000\n",
      "1      Laptop  50000    1       50000\n",
      "2  Headphones   2000    3        6000\n",
      "3    Keyboard   1000    2        2000\n"
     ]
    }
   ],
   "source": [
    "df = pd.DataFrame(data)\n",
    "\n",
    "df[\"TotalValue\"] = df[\"Price\"] * df[\"Qty\"]\n",
    "\n",
    "print(df)"
   ]
  },
