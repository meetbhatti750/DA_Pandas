   "outputs": [],
   "source": [
    "import pandas as pd"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "a261c683",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = {\n",
    "    \"Item\": [\"Pizza\", \"Burger\", \"Sandwich\", \"Pasta\"],\n",
    "    \"Price\": [200, 100, 80, 150],\n",
    "    \"Qty\": [2, 3, 1, 2]\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c9bc1947",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "       Item  Price  Qty  DiscountedPrice\n",
      "0     Pizza    200    2            180.0\n",
      "1    Burger    100    3             90.0\n",
      "2  Sandwich     80    1             72.0\n",
      "3     Pasta    150    2            135.0\n"
     ]
    }
   ],
   "source": [
    "df = pd.DataFrame(data)\n",
    "\n",
    "df[\"DiscountedPrice\"] = df[\"Price\"].apply(\n",
    "    lambda price: price * 0.90\n",
    ")\n",
    "\n",
    "print(df)"
   ]
  }
 ],
