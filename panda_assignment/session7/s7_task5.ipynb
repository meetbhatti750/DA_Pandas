     "text": [
      "   Product  Price  Qty    GST\n",
      "0  T-Shirt    500    2   50.0\n",
      "1    Jeans   1200    1   60.0\n",
      "2    Shoes   2000    1  100.0\n",
      "3   Jacket   1500    2  150.0\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "data = {\n",
    "    \"Product\": [\"T-Shirt\", \"Jeans\", \"Shoes\", \"Jacket\"],\n",
    "    \"Price\": [500, 1200, 2000, 1500],\n",
    "    \"Qty\": [2, 1, 1, 2]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "df[\"GST\"] = df.apply(\n",
    "    lambda x: (x[\"Price\"] * x[\"Qty\"]) * 0.05,\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "print(df)\n"
   ]
  },
