     "name": "stdout",
     "output_type": "stream",
     "text": [
      "DatetimeIndex(['2026-10-15', '2026-10-16', '2026-10-17', '2026-10-18',\n",
      "               '2026-10-19', '2026-10-20', '2026-10-21'],\n",
      "              dtype='datetime64[us]', freq='D')\n"
     ]
    }
   ],
   "source": [
    "print(dates)"
   ]
  }
